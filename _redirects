# Old listen.html?r=<slug> links (live in ads and bios) are handled by a
# small script in initListenPage() (script.js) that reads ?r= and redirects
# to the permanent /listen/N link — Cloudflare Pages _redirects doesn't
# match on query strings and allows only one rule per path, so per-slug
# redirect lines here aren't possible.
/listen.html /listen 301

# Numbered permanent links: rewrite to the extensionless /listen, NOT
# /listen.html — Cloudflare Pages auto-redirects any .html destination back
# to its clean-url form, which turned a rewrite straight to listen.html into
# an infinite redirect loop. Bare /listen needs no rule of its own:
# Cloudflare already auto-serves listen.html there, the same as every other
# page (bio.html at /bio, etc.) with no _redirects entry at all.
/listen/* /listen 200
