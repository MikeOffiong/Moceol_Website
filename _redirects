# Old listen.html?r=<slug> links (live in ads and bios) are handled by a
# small script in initListenPage() (script.js) that reads ?r= and redirects
# to the permanent /listen/N link — Cloudflare Pages _redirects doesn't
# match on query strings and allows only one rule per path, so per-slug
# redirect lines here aren't possible.
/listen.html /listen 301

# Clean routes: serve listen.html's content with a 200 (URL stays exactly as
# typed — no .html, no query string, no song name or random code).
/listen /listen.html 200
/listen/* /listen.html 200
